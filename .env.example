# Copy this file to `.env` and fill from your Monnify dashboard → Developer page.
# NEVER commit the real .env.

# Developer → API Keys & Contracts → "Show Keys"
MONNIFY_API_KEY=MK_TEST_xxxxxxxxxx
MONNIFY_SECRET_KEY=xxxxxxxxxxxxxxxxxxxx

# Sandbox base URL (Developer page shows it; sandbox is usually this)
MONNIFY_BASE_URL=https://sandbox.monnify.com

# Developer → Contract Code
MONNIFY_CONTRACT_CODE=4523534626

# Developer → Wallet Account Number (source account for disbursements)
MONNIFY_WALLET_ACCOUNT_NUMBER=

# A test destination for the disbursement proof.
# Use a known Monnify sandbox test account, or one of your own reserved accounts.
TEST_DEST_ACCOUNT_NUMBER=0000000000
TEST_DEST_BANK_CODE=058

# Port for the local webhook receiver
WEBHOOK_PORT=4000

# ---- Convex (all of Aide's data) ----
# You do NOT set these by hand. Run `npx convex dev` in a second terminal and it
# creates a deployment and writes CONVEX_DEPLOYMENT + NEXT_PUBLIC_CONVEX_URL
# into .env.local for you. Leave that terminal running while you develop — it
# also pushes changes in convex/ to the backend.
# The demo worker and employer accounts seed themselves on first request, so a
# brand-new deployment works immediately with no extra step.

# ---- Session signing (REQUIRED in production) ----
# Signs the cookies that decide who a request is. Without it, anyone can forge
# a session for any account, so the app refuses to start in production rather
# than run with a key that ships in this repository.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Locally you can leave it unset — a development-only default is used.
SESSION_SECRET=

# ---- BMONI Embedded (the stablecoin money layer) ----
# Additive: Monnify stays the default. Nothing below is read unless the BMONI
# provider is selected, so an unset block leaves the app exactly as it was.
#
# Selection is explicit opt-in. Anything that is not exactly "bmoni" — a typo,
# a half-set value — falls back to Monnify, so a mistake here cannot silently
# move real wages onto the sandbox integration.
# AIDE_PAYMENT_PROVIDER=bmoni

# BMONI_BASE_URL=https://embedded-dev.bmoni.com
# BMONI_API_KEY=pk_xxxxxxxx

# BMONI's name enquiry is per-user, unlike Monnify's global one. Verifying a
# destination before a payer is known needs some user context to call as.
# BMONI_VERIFY_AS_USER_ID=

# The development host does NOT perform bank-account name enquiry. It returns a
# plausible Nigerian name for any ten-digit number against any bank code —
# deterministic per number, so two look-ups agree and it reads like a real
# answer. Measured: 4534076021 returns "Dillon Bunch" against six different
# banks; 0123456789 returns "Ekon Orji".
#
# Left OFF by default, so Aide surfaces whatever the provider says and behaves
# the same here as on production. Harmless while the sandbox wallets hold no
# money and the personas are not real people.
#
# Turn it on before this points at a funded wallet on any host whose name
# enquiry has not been confirmed as real. Aide then refuses to show or speak an
# unverified holder name and reads the account digits back instead — the part
# the user actually supplied and can check. BMONI's docs cover sandbox
# behaviour for BVN/NIN look-ups in detail and say nothing about this endpoint.
# BMONI_STRICT_NAME_ENQUIRY=true

# Encrypts every user's smart-wallet owner private key before it is stored.
# Aide holds these keys because BMONI's SDK requires an on-screen PIN per
# signature, which is what the spoken security phrase replaces — so whoever
# holds this secret can sign transfers. There is deliberately NO default and no
# fallback: without it, sealing and opening keys both refuse to run.
# Generate one with:
#   openssl rand -hex 32
# BMONI_KEY_SECRET=

# ---- TEMPORARY: demo balance stand-in ----
# Leave this UNSET. When set, it stands in for the confirmed balance ONLY when
# Monnify cannot be reached at all — a number the app otherwise refuses to
# invent. It never overrides a real balance, and every use is logged loudly.
# It exists so a demo survives a provider outage; remove it once the sandbox is
# answering again.
# AIDE_DEMO_BALANCE=12000

# ---- Aide agent (voice loop) ----
# DeepSeek API key for the Aide agent. Get one at platform.deepseek.com.
# DeepSeek is OpenAI-compatible, supports tool calling, and is far cheaper than Claude.
DEEPSEEK_API_KEY=sk-xxxxxxxx
# Optional model override (defaults to deepseek-chat; must support tool calling)
AIDE_MODEL=deepseek-chat

# Fallback provider. DeepSeek is the default, but a dead key or an empty balance
# should not be able to take Aide down. Any OpenAI-compatible endpoint works —
# set BOTH of these plus AIDE_MODEL, and the app switches with no code change.
# Whatever you point it at MUST support tool calling; Aide is tool-driven.
#   AIDE_OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   AIDE_API_KEY=gsk_xxxxxxxx
#   AIDE_MODEL=llama-3.3-70b-versatile
# AIDE_OPENAI_BASE_URL=
# AIDE_API_KEY=

# ---- Neural text-to-speech (Edge TTS via Python subprocess) ----
# Requires Python 3 + `pip install edge-tts` on this machine (see
# requirements.txt). No API key needed — this calls Microsoft's free Edge
# voices through Python's edge_tts library, which (unlike the Node ws-based
# npm package) isn't blocked with a 403.
# Optional voice override — en-NG-EzinneNeural (female) / en-NG-AbeoNeural
# (male) are the only two Nigerian English neural voices in the catalog.
EDGE_TTS_VOICE=en-NG-EzinneNeural
# Optional override if `python` isn't on PATH (e.g. "python3", or a full path).
PYTHON_BIN=python

# Where the browser fetches speech from. Leave UNSET locally: the Next route at
# /api/tts keeps one warm Python subprocess alive, which is much faster for
# development. In production it is set to /api/speak, the native Python
# serverless function — a serverless function can't hold a child process.
# NEXT_PUBLIC_TTS_PATH=/api/speak
